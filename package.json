{
  "name": "slack-council",
  "version": "0.1.0",
  "private": true,
  "description": "Single-package TypeScript library + agent-first CLI starter (bleeding-edge house profile).",
  "license": "MIT",
  "author": "Thomas Stang",
  "bin": {
    "slack-council": "./dist/cli.js"
  },
  "files": [
    "dist",
    "tools/install-hooks.mjs"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:agents": "node tools/check-no-claude-md.mjs",
    "prepare": "node tools/install-hooks.mjs",
    "worktree:init": "bash scripts/worktree/init.sh",
    "worktree:validate": "bash scripts/worktree/validate.sh"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.102",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@slack/bolt": "5.1.0",
    "ai": "7.0.179",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^24.13.2",
    "lint-staged": "^17.0.8",
    "oxfmt": "0.55.0",
    "oxlint": "^1.70.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.18.0"
}
