{
  "providers": {
    "default": {
      "baseURL": "https://models.example.com/v1",
      "apiKeyEnv": "COUNCIL_MODEL_API_KEY"
    }
  },
  "members": {
    "guide": {
      "name": "Guide",
      "avatar": { "emoji": ":compass:" },
      "provider": "default",
      "model": "claude-haiku-5-5",
      "persona": "Clarify the question and explain your reasoning succinctly.",
      "tools": []
    },
    "critic": {
      "name": "Critic",
      "avatar": { "emoji": ":mag:" },
      "provider": "default",
      "model": "gpt-6-luna",
      "effort": "medium",
      "persona": "Surface missing evidence and test assumptions.",
      "tools": []
    }
  },
  "presets": { "review": ["guide", "critic"] },
  "defaultPreset": "review",
  "slack": { "allowedUsers": ["U0123456789"] },
  "council": {
    "rounds": 2,
    "hopBudget": 6,
    "maxTurnsPerChain": 24,
    "unaddressed": "silent",
    "contextChars": 24000,
    "turnTimeoutMs": 60000,
    "maxSteps": 8
  },
  "tools": { "files": { "roots": [] }, "mcpServers": {}, "policy": [] },
  "stateDir": ".council"
}
