#!/usr/bin/env sh
# Cheap feedback before pushing: agent-file guard + typecheck.
# No test suite runs here.
# Run the repo's required final checks explicitly; see README verification policy.
# Escape hatch: GIT_HOOKS=0 git push ...
[ "$GIT_HOOKS" = "0" ] && exit 0

set -e

# Git exports repository-binding variables (GIT_DIR, GIT_INDEX_FILE, ...) to
# hooks; inherited by tests that spawn git, they redirect fixtures into this repo.
for var in $(git rev-parse --local-env-vars); do unset "$var"; done

echo "pre-push: agent-file guard"
pnpm run check:agents

echo "pre-push: typecheck"
pnpm run typecheck
